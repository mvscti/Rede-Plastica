{
    "name": "if-muriae/rede-plastica",
    "description": "Plataforma de conexão entre coletores e recicladores de resíduos",
    "version": "0.0.1",
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Tests\\": "tests/"
        },
        "files": [
            "config/constants.php"
        ]
    },
    "authors": [
        {
            "name": "Marcus Vinícius Souza Costa",
            "email": "marcus.costa@ifsudestemg.edu.br"
        },
        {
            "name": "Gustavo Teixeira",
            "email": "gteixeiradesousa7@gmail.com"
        },
        {
            "name": "Pedro Henrique Lacerda Silva Soares"
        },
        {
            "name": "Gabriella Moreno Silveira Louzada"
        },
        {
            "name": "Alexandre João Souza de Araújo"
        }
    ],
    "require": {
        "php": ">=8.4",
        "slim/slim": "^4.14",
        "slim/psr7": "^1.7",
        "php-di/php-di": "^7.0",
        "vlucas/phpdotenv": "^5.6",
        "doctrine/orm": "^3.5",
        "symfony/cache": "^7.3",
        "symfony/validator": "^7.3",
        "symfony/translation": "^7.3",
        "zeuxisoo/slim-whoops": "^0.7.3"
    },
    "require-dev": {
        "pestphp/pest": "^4.1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "doctrine": "@php src/Infrastructure/Cli/Doctrine/cli-config.php",
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "test": "./vendor/bin/pest --colors=always"
    }
}
